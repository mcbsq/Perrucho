# .env.example
# Copia este archivo como .env y completa los valores reales.
# NO subir .env al repositorio — está en .gitignore.

# ── Base de datos (Neon PostgreSQL) ──────────────────────────────────────────
# Cadena pooled — usada por la app en runtime.
POSTGRES_PRISMA_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?channel_binding=require&connect_timeout=15&sslmode=require
# Cadena directa (sin pooler) — usada por prisma migrate.
POSTGRES_URL_NON_POOLING=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?channel_binding=require&sslmode=require

# ── JWT ───────────────────────────────────────────────────────────────────────
# Genera uno nuevo con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# ── URLs ──────────────────────────────────────────────────────────────────────
REACT_APP_API_URL=http://localhost:3001/api
FRONTEND_URL=http://localhost:3000

# ── AEGIS (identidad/credenciales — multi-tenant) ─────────────────────────────
AEGIS_BASE_URL=
AEGIS_TENANT_ID=
AEGIS_APP_ID=
AEGIS_API_KEY=

# ── Correo (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=Perrucho <onboarding@resend.dev>

# ── Entorno ───────────────────────────────────────────────────────────────────
NODE_ENV=development
