// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  administrador
  empleado
  cliente
  // Cuenta única, por encima de cualquier negocio (businessId null) — ve y
  // puede entrar a cualquier empresa registrada en la plataforma. No es un
  // rol que se asigne desde ninguna UI de negocio, solo existe la cuenta
  // maestra creada aparte (ver scripts/createSuperAdmin.js).
  superadmin
}

enum AppointmentStatus {
  Pendiente
  Confirmada
  EnProceso
  Completada
  Cancelada
}

enum PaymentMethod {
  efectivo
  tarjeta
  transferencia
}

enum SaleStatus {
  pagado
  pendiente
}

enum SaleType {
  service
  product
  mixed
}

// ─────────────────────────────────────────────
// BUSINESS (multi-tenant — cada negocio vive aislado bajo su propio slug,
// ej. perrucho.com/taylors, perrucho.com/empresa2)
// ─────────────────────────────────────────────

model Business {
  id   Int    @id @default(autoincrement())
  slug String @unique // URL: perrucho.com/<slug>
  name String

  // Giro del negocio — texto libre que indexa a src/config/giroPresets.js
  // (banco de plantillas: veterinaria, uñas y pestañas, spa, etc). No es un
  // enum a propósito: agregar un giro nuevo debe ser solo código, sin migración.
  giro String @default("mascotas")

  // Identidad AEGIS de este negocio — nullable hasta confirmar con AEGIS si
  // cada negocio tiene su propio tenant o comparten uno con scoping interno.
  aegisTenantId String?

  // "local" (password propio, bcrypt) | "aegis" (AEGIS es dueño de las
  // credenciales) — permite migrar cada negocio a AEGIS de uno en uno sin
  // tener que cortar todos al mismo tiempo.
  authProvider String @default("local")

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  users           User[]
  pets            Pet[]
  services        Service[]
  products        Product[]
  appointments    Appointment[]
  expenses        Expense[]
  sales           Sale[]
  // Settings.businessId todavía no es @unique (se aprieta en la migración de
  // "tightening" de Fase 1) — hasta entonces la relación inversa es a lista,
  // no 1:1, para que Prisma no exija unicidad prematura.
  settings        Settings[]
  membershipPlans MembershipPlan[]
}

// ─────────────────────────────────────────────
// USER (unifica users + clients del db.json)
// ─────────────────────────────────────────────

model User {
  id                 Int       @id @default(autoincrement())
  name               String
  email              String    @unique
  // AEGIS es dueño de las credenciales para negocios con authProvider
  // "aegis" (ver Business.authProvider) — esas filas no llevan password,
  // solo aegisUserId. Los negocios que sigan en "local" (ej. Taylor's,
  // hasta su propio cutover) siguen usando password con bcrypt como hoy.
  password           String?
  aegisUserId        String?   @unique
  role               Role      @default(cliente)
  // Multi-tenant: nullable por ahora — Fase 1 solo agrega y respalda la
  // columna (backfill a Taylor's), sin tocar código de aplicación todavía.
  // Se aprieta a NOT NULL + uniqueness compuesta con email en una migración
  // posterior, una vez que el código de Fase 2 ya la escriba en cada insert.
  businessId         Int?
  phone              String?
  address            String?
  capacity           Int? // solo empleados: cuántas citas simultáneas puede atender
  createdAt          DateTime  @default(now())
  // Valores de los campos extra configurados en Settings.clientExtraFields
  // (varían según el giro del negocio, ej. podología vs. estética canina)
  extraData          Json      @default("{}")
  // "Olvidé mi contraseña" — token de un solo uso con expiración (1h)
  resetToken         String?   @unique
  resetTokenExpiry   DateTime?
  // Recuperación 100% interna (sin SMTP): pregunta de seguridad elegida al
  // registrarse. La respuesta se guarda hasheada, nunca en texto plano.
  securityQuestion   String?
  securityAnswerHash String?

  // Expediente clínico (giro clínica) — mismo patrón que Pet.history:
  // un JSON de notas en la propia fila, no una tabla aparte. Cada entrada:
  // { date, appointmentId, authorName, note }. Solo se usa si el negocio
  // tiene Settings.enableClientNotes.
  clinicalHistory Json @default("[]")

  // Membresía (giro gimnasio) — solo la vigencia ACTUAL, sin historial de
  // renovaciones pasadas (YAGNI). Renovar = mover membershipExpiresAt hacia
  // adelante. Solo se usa si el negocio tiene Settings.enableMemberships.
  membershipPlanId      Int?
  membershipExpiresAt   DateTime?
  membershipClassesUsed Int?
  membershipPlan        MembershipPlan? @relation(fields: [membershipPlanId], references: [id])

  // Relaciones
  business             Business?     @relation(fields: [businessId], references: [id])
  pets                 Pet[]
  appointments         Appointment[] // citas donde este user es el cliente
  assignedAppointments Appointment[] @relation("AssignedEmployee")
  sales                Sale[]
  expenses             Expense[]
}

// ─────────────────────────────────────────────
// PET
// ─────────────────────────────────────────────

model Pet {
  id         Int      @id @default(autoincrement())
  petName    String
  species    String   @default("perro")
  breed      String?
  weight     String?
  notes      String?
  status     String   @default("activo") // activo | inactivo
  history    Json     @default("[]")
  ownerId    Int
  businessId Int? // multi-tenant — ver nota en User.businessId
  createdAt  DateTime @default(now())

  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  business     Business?     @relation(fields: [businessId], references: [id])
  appointments Appointment[]
}

// ─────────────────────────────────────────────
// SERVICE
// ─────────────────────────────────────────────

model Service {
  id          Int     @id @default(autoincrement())
  title       String
  description String  @db.Text
  category    String
  icon        String  @default("🐾")
  color       String  @default("blue")
  popular     Boolean @default(false)
  // Foto real (subida o elegida de la galería de stock) — si existe, se
  // muestra en vez del emoji en las tarjetas públicas y del POS.
  imageUrl    String?

  // Visibilidad: si es false, el servicio solo aparece en Punto de Venta,
  // no en la página pública de inicio (petición del cliente vía CIBERCOM).
  showOnHome Boolean @default(true)

  // Criterio de cobro: "weight" usa los 6 tiers de peso de abajo;
  // "custom" usa customPriceOptions (ej. tipo de trabajo en un negocio de uñas).
  pricingMode        String @default("weight") // "weight" | "custom"
  customPriceOptions Json   @default("[]") // [{ label: string, price: number }]

  // Precios por tamaño (tier de peso) — usados si pricingMode = "weight"
  priceMini    Int @default(0)
  priceChico   Int @default(0)
  priceMediano Int @default(0)
  priceGrande  Int @default(0)
  priceExtra   Int @default(0)
  priceJumbo   Int @default(0)
  price        Int @default(0) // fallback / precio base

  // Duración real de la cita en minutos — antes el sistema generaba slots
  // cada 45 min sin importar el servicio (un corte de 20 min y una estética
  // completa de 90 min ocupaban el mismo hueco). 45 es el valor que ya
  // regía implícitamente vía SHOP_TIME_SLOTS, así que este default no
  // cambia el comportamiento de ningún servicio existente.
  durationMinutes Int @default(45)

  // Giro gimnasio: marca qué servicios son "clases" sujetas a membresía
  // (vs. un servicio suelto de pago único, ej. una valoración inicial).
  isClass Boolean @default(false)

  businessId Int? // multi-tenant — ver nota en User.businessId
  business   Business? @relation(fields: [businessId], references: [id])

  appointments      Appointment[]
  appointmentExtras AppointmentExtra[]
}

// ─────────────────────────────────────────────
// MEMBERSHIP PLAN (giro gimnasio) — catálogo de planes, mismo patrón que
// Service. La membresía ACTUAL de un cliente vive en User (ver
// membershipPlanId/membershipExpiresAt) — sin tabla de historial aparte.
// ─────────────────────────────────────────────

model MembershipPlan {
  id           Int    @id @default(autoincrement())
  name         String
  price        Int
  durationDays Int    @default(30)
  classesLimit Int? // null = ilimitado

  businessId Int?
  business   Business? @relation(fields: [businessId], references: [id])

  members User[]
}

// ─────────────────────────────────────────────
// PRODUCT
// ─────────────────────────────────────────────

model Product {
  id          Int     @id @default(autoincrement())
  name        String
  price       Int
  stock       Int     @default(0)
  category    String
  description String?
  // Foto real (subida o elegida de la galería de stock).
  imageUrl    String?
  // Variantes (ej. presentaciones/tallas/colores) con su propio precio y
  // stock — si está vacío, el producto se vende como una sola unidad.
  variants    Json    @default("[]") // [{ name, price, stock }]

  businessId Int? // multi-tenant — ver nota en User.businessId
  business   Business? @relation(fields: [businessId], references: [id])

  saleItems SaleItem[]
}

// ─────────────────────────────────────────────
// APPOINTMENT
// ─────────────────────────────────────────────

model Appointment {
  id         Int               @id @default(autoincrement())
  clientId   Int?
  petId      Int?
  serviceId  Int?
  employeeId Int?
  date       String // "YYYY-MM-DD" — string para evitar timezone drift
  time       String // "HH:mm"
  status     AppointmentStatus @default(Pendiente)
  finalPrice Int               @default(0)
  notes      String?
  guestName  String? // booking express sin cuenta — nombre del dueño
  guestPhone String? // booking express sin cuenta — WhatsApp para confirmar
  businessId Int? // multi-tenant — ver nota en User.businessId
  createdAt  DateTime          @default(now())

  client   User?     @relation(fields: [clientId], references: [id])
  pet      Pet?      @relation(fields: [petId], references: [id])
  service  Service?  @relation(fields: [serviceId], references: [id])
  employee User?     @relation("AssignedEmployee", fields: [employeeId], references: [id])
  business Business? @relation(fields: [businessId], references: [id])

  extras AppointmentExtra[] // servicios adicionales (punto 3 del cliente)
  sale   Sale?
}

// ─────────────────────────────────────────────
// APPOINTMENT EXTRA (servicios adicionales — punto 3)
// ─────────────────────────────────────────────

model AppointmentExtra {
  id            Int @id @default(autoincrement())
  appointmentId Int
  serviceId     Int
  price         Int @default(0)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id])
}

// ─────────────────────────────────────────────
// EXPENSE (egresos/gastos — Panel de control solo mostraba ingresos)
// ─────────────────────────────────────────────

model Expense {
  id         Int      @id @default(autoincrement())
  concept    String
  amount     Int
  category   String   @default("Otro")
  notes      String?
  date       DateTime @default(now())
  createdBy  Int?
  businessId Int? // multi-tenant — ver nota en User.businessId

  creator  User?     @relation(fields: [createdBy], references: [id])
  business Business? @relation(fields: [businessId], references: [id])
}

// ─────────────────────────────────────────────
// SALE
// ─────────────────────────────────────────────

model Sale {
  id            Int           @id @default(autoincrement())
  clientId      Int?
  employeeId    Int?
  appointmentId Int?          @unique
  total         Int
  paymentMethod PaymentMethod @default(efectivo)
  status        SaleStatus    @default(pendiente)
  type          SaleType      @default(service)
  notes         String?
  date          DateTime      @default(now())
  businessId    Int? // multi-tenant — ver nota en User.businessId

  client      User?        @relation(fields: [clientId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  business    Business?    @relation(fields: [businessId], references: [id])
  items       SaleItem[]
}

// ─────────────────────────────────────────────
// SALE ITEM (líneas del carrito)
// ─────────────────────────────────────────────

model SaleItem {
  id        Int    @id @default(autoincrement())
  saleId    Int
  productId Int?
  name      String // nombre del producto/servicio al momento de la venta
  price     Int
  quantity  Int    @default(1)

  sale    Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])
}

// ─────────────────────────────────────────────
// SETTINGS (configuración global — toggle booking express, etc.)
// ─────────────────────────────────────────────

model Settings {
  // Multi-tenant: ya no es un singleton (@default(1) chocaba con cualquier
  // negocio nuevo — bug real encontrado al probar la Fase 4). Un registro
  // por negocio, identificado por businessId (ver nota abajo).
  id                Int       @id @default(autoincrement())
  // Multi-tenant: nullable por ahora (Fase 1 solo agrega+respalda). Pasará a
  // @unique NOT NULL en la migración de "tightening" de Fase 1, momento en
  // el que Settings deja de ser un singleton y pasa a 1 fila por negocio —
  // el @default(1) de arriba se elimina en ese mismo paso.
  businessId        Int?
  business          Business? @relation(fields: [businessId], references: [id])
  allowGuestBooking Boolean   @default(true) // toggle admin: booking express on/off
  // Bug real (Emporio Uñas/Pestañas, reportado por el cliente): estos
  // defaults eran literalmente el WhatsApp/dirección/redes REALES de
  // Taylor's — cualquier negocio nuevo que no los llenara heredaba los
  // contactos de otro negocio. Vacíos por default; el registro y
  // Personalización son quienes deben llenarlos con datos propios.
  whatsappNumber    String    @default("")
  businessAddress   String    @default("")
  businessMapsUrl   String    @default("")
  instagramUrl      String    @default("")
  facebookUrl       String    @default("")
  tiktokUrl         String    @default("")

  // ── Personalización (branding) ──────────────────────────────────────────
  businessName       String  @default("Mi negocio")
  slogan             String  @default("Reserva tu cita en minutos")
  // Línea pequeña sobre el título del hero (ej. "Grooming · Tienda · Guardería · Paseos")
  // y el párrafo debajo del título — antes hardcodeados en Home.jsx.
  heroTagline        String  @default("Grooming · Tienda · Guardería · Paseos")
  heroSubtitle       String  @default("Baño, corte, arreglo de uñas y más. Agenda tu cita en minutos.")
  logoUrl            String?
  primaryColor       String  @default("#4f46e5")
  // Personalización extendida: color secundario (acentos/gradientes), tipografía
  // y el modo de tema (claro/oscuro/automático) que ve un visitante nuevo por
  // defecto — el toggle del usuario en su propio navegador siempre tiene prioridad.
  secondaryColor     String  @default("#a29bfe")
  fontFamily         String  @default("system")
  defaultTheme       String  @default("auto") // 'light' | 'dark' | 'auto'
  // Imagen del hero (portada de inicio) — si está vacía se sigue mostrando
  // el video por defecto. Fondo de la pantalla de inicio de sesión/registro.
  heroImageUrl       String?
  loginBackgroundUrl String?

  // ── "¿Cómo funciona?" — pasos y logros, editables ───────────────────────
  // Cada paso puede tener un emoji (icon) y/o una imagen subida (imageUrl,
  // base64) — si hay imageUrl, se muestra en vez del emoji.
  howItWorksSteps Json @default("[]") // [{ icon, imageUrl, title, description }]
  // Logros/estadísticas — lista libre, el admin agrega/quita las que quiera.
  // Vacío por default: mostrar "4000+ clientes felices" (los de Taylor's)
  // en un negocio que se acaba de registrar con cero clientes reales era
  // directamente falso, no solo mal branding — mismo bug que los contactos.
  stats           Json @default("[]") // [{ value, label, icon }]

  // ── "¿Por qué elegirnos?" — antes hardcodeado en Home.jsx (WhyUsSection/FEATURES) ──
  whyUsTitle    String @default("¿Por qué elegirnos?")
  whyUsSubtitle String @default("Comprometidos con darte un servicio profesional, puntual y de calidad.")
  whyUsFeatures Json   @default("[{\"icon\":\"⭐\",\"title\":\"Calidad garantizada\",\"desc\":\"Servicio profesional con atención al detalle en cada cita.\"},{\"icon\":\"📅\",\"title\":\"Agenda en línea\",\"desc\":\"Reserva tu cita en segundos desde cualquier dispositivo. Fácil y sin complicaciones.\"},{\"icon\":\"👥\",\"title\":\"Equipo capacitado\",\"desc\":\"Personal en constante formación para brindarte el mejor servicio.\"},{\"icon\":\"💳\",\"title\":\"Pago sencillo\",\"desc\":\"Cobra y recibe tu recibo al instante, sin complicaciones.\"}]") // [{ icon, title, desc }]

  // ── Footer editable ──────────────────────────────────────────────────────
  footerLinks Json @default("[]") // [{ label, url }]

  // ── Horarios de atención ─────────────────────────────────────────────────
  // Antes el horario (10:15-17:00, todos los días) vivía hardcodeado en 3
  // lugares distintos (bookingRules.js, SHOP_TIME_SLOTS en api/index.js, y
  // un arreglo duplicado en Home.jsx) — el mismo para TODOS los negocios,
  // sin días cerrados. Un arreglo de 7 entradas, índice = Date.getDay()
  // (0=domingo...6=sábado). El default reproduce exactamente ese horario
  // global anterior, así que ningún negocio existente (incluido Taylor's)
  // cambia de comportamiento hasta que un admin lo edite en Personalización.
  businessHours Json @default("[{\"day\":0,\"open\":true,\"start\":\"10:15\",\"end\":\"17:00\"},{\"day\":1,\"open\":true,\"start\":\"10:15\",\"end\":\"17:00\"},{\"day\":2,\"open\":true,\"start\":\"10:15\",\"end\":\"17:00\"},{\"day\":3,\"open\":true,\"start\":\"10:15\",\"end\":\"17:00\"},{\"day\":4,\"open\":true,\"start\":\"10:15\",\"end\":\"17:00\"},{\"day\":5,\"open\":true,\"start\":\"10:15\",\"end\":\"17:00\"},{\"day\":6,\"open\":true,\"start\":\"10:15\",\"end\":\"17:00\"}]")

  // ── Adaptable a otros giros de negocio ──────────────────────────────────
  // Si el negocio no maneja mascotas (podología, barbería, spa, etc.),
  // el admin puede ocultar toda la sección de "Pacientes" y el registro
  // de mascotas, sin perder la funcionalidad para quien sí la usa (Taylor's).
  enablePets        Boolean @default(true)
  clientExtraFields Json    @default("[]") // [{ key, label, required }] — campos extra de registro de cliente

  // ── Herramientas específicas por giro (todas apagadas por default) ──────
  // Igual que enablePets: el default de abajo es el valor SEGURO que no
  // cambia el comportamiento de ningún negocio ya existente (incluido
  // Taylor's) — el valor real por giro se escribe explícito al registrar un
  // negocio nuevo (ver api/index.js POST /api/business/register), leyendo
  // giroPresets.js. Un admin puede prenderlas/apagarlas después en
  // Personalización → "Giro de negocio".
  enableStaffSelection    Boolean @default(false) // elegir quién te atiende al reservar
  enableMemberships       Boolean @default(false) // giro gimnasio
  enableClientNotes       Boolean @default(false) // giro clínica — expediente
  enableTableReservations Boolean @default(false) // giro alimentos — reservar mesa vs. solo mostrador
}
